# Copy to .env.local for local development and add the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Optional: public address used for canonical links, the sitemap and link previews.
# Defaults to https://ccd.gdgcloudpune.in.
# SITE_URL=https://ccd.gdgcloudpune.in

# Optional: Google Analytics 4 measurement ID. Defaults to the ccd.gdgcloudpune.in web stream,
# and only Vercel's production deployment reports to it.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
