# Copy to .env.local for local development and add the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# All of these are server-only: do NOT prefix any of them with NEXT_PUBLIC_.

# Firebase Admin SDK — Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences exactly as they appear in the downloaded JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ZeptoMail (India data centre) — Mail Agents → SMTP/API → Send Mail token.
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_API_KEY=replace-with-send-mail-token
# Must be an address on a domain verified in ZeptoMail.
ZEPTOMAIL_FROM_ADDRESS=noreply@example.com
ZEPTOMAIL_FROM_NAME=GDG Cloud Pune
# Optional: where replies go. Defaults to contact@gdgcloudpune.in when unset.
ZEPTOMAIL_REPLY_TO=contact@gdgcloudpune.in

# Random secret used to hash IP addresses for rate limiting. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=replace-with-a-long-random-string
